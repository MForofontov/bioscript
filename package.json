{
  "name": "bioscript",
  "version": "0.1.0",
  "private": true,
  "description": "Bioinformatics tools and utilities monorepo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MForofontov/bioscript.git"
  },
  "homepage": "https://github.com/MForofontov/bioscript#readme",
  "bugs": {
    "url": "https://github.com/MForofontov/bioscript/issues"
  },
  "author": "MForofontov",
  "engines": {
    "node": ">=16.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/workspaces.cjs build",
    "test": "npm run build && npm run test:unit",
    "test:watch": "jest --watch",
    "test:seq-stream": "npm test -w @bioscript/seq-stream",
    "test:coverage": "jest --coverage",
    "test:browser": "npm run build && node scripts/workspaces.cjs browser",
    "test:all": "npm run build && npm run test:unit && node scripts/workspaces.cjs browser",
    "test:install:full": "npm ci --ignore-scripts && npm run verify",
    "publish:all": "./scripts/publish-packages.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,cjs,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,mjs,json,md,yml,yaml}\"",
    "prepare": "npm run build",
    "typecheck": "node scripts/workspaces.cjs typecheck",
    "test:github": "npm run test:all",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && node scripts/workspaces.cjs browser && npm run validate:reference && npm run test:packages",
    "validate:reference": "ts-node packages/seq-align/scripts/validate-reference.ts",
    "test:packages": "node scripts/package-smoke.cjs",
    "benchmark": "node scripts/benchmark.cjs",
    "test:unit": "jest",
    "test:stress": "npm run build && node scripts/workspaces.cjs stress"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.58.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "allure-commandline": "^2.34.1",
    "allure-jest": "^3.3.2",
    "allure-playwright": "^3.3.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "http-server": "^14.1.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-html-reporter": "^3.10.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.15.0"
  }
}
