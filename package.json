{
  "name": "bioscript",
  "version": "0.1.0",
  "private": true,
  "description": "Bioinformatics tools and utilities monorepo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MForofontov/bioscript.git"
  },
  "homepage": "https://github.com/MForofontov/bioscript#readme",
  "bugs": {
    "url": "https://github.com/MForofontov/bioscript/issues"
  },
  "author": "MForofontov",
  "engines": {
    "node": ">=16.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc && npm run build -w @bioscript/seq-utils && npm run build -w @bioscript/seq-stream && npm run build -w @bioscript/seq-align && npm run build -w @bioscript/seq-format && npm run build -w @bioscript/seq-translate && npm run build -w @bioscript/seq-search && npm run build -w @bioscript/seq-quality",
    "typecheck": "npm run build -w @bioscript/seq-utils && npx tsc --noEmit -p packages/seq-utils/tsconfig.json && npx tsc --noEmit -p packages/seq-stream/tsconfig.json && npx tsc --noEmit -p packages/seq-align/tsconfig.json && npx tsc --noEmit -p packages/seq-format/tsconfig.json && npx tsc --noEmit -p packages/seq-translate/tsconfig.json && npx tsc --noEmit -p packages/seq-search/tsconfig.json && npx tsc --noEmit -p packages/seq-quality/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:seq-stream": "npm test -w @bioscript/seq-stream",
    "test:coverage": "jest --coverage",
    "test:browser": "npm run test:browser --workspaces --if-present",
    "test:all": "npm test && npm run test:browser",
    "validate:reference": "npm run validate:reference -w @bioscript/seq-align",
    "test:install:full": "./scripts/test-install-full.sh",
    "publish:all": "./scripts/publish-packages.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.58.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "allure-commandline": "^2.34.1",
    "allure-jest": "^3.3.2",
    "allure-playwright": "^3.3.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "http-server": "^14.1.1",
    "jest": "^29.5.0",
    "jest-allure": "^0.1.3",
    "jest-environment-jsdom": "^29.5.0",
    "jest-html-reporter": "^3.10.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.15.0"
  }
}
